# Requis pour connecter le bot Discord
DISCORD_TOKEN=

# Recherche du catalogue Spotify (morceaux, artistes, albums, playlists publiques)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Facultatif : active des replis API SoundCloud supplémentaires (yt-dlp fonctionne sans clé)
SOUNDCLOUD_CLIENT_ID=

# Facultatif : marché utilisé pour la recherche Spotify (ISO pays)
MUSIC_MARKET=FR

# Facultatif : dossier SQLite; sur Kinetic, le dossier du serveur persiste entre redémarrages
BOT_DATA_DIR=

# Facultatif : chemins personnalisés; yt-dlp est téléchargé automatiquement s'il manque
YTDLP_PATH=
# Chemin relatif ou absolu. Plusieurs fichiers séparés par ; : premier prioritaire, suivants en secours.
# Vide : détecte data/youtube-cookies.txt s'il existe.
YOUTUBE_COOKIES_PATH=
FFMPEG_PATH=

# Quitte le vocal après 1 ou 2 minutes sans musique (défaut : 2)
VOICE_IDLE_TIMEOUT_MINUTES=2

# Facultatif
COMMAND_PREFIX=!

# Conversation IA à la demande : désactivée tant qu'un fournisseur n'est pas choisi.
# Valeurs : disabled, openai, anthropic, gemini ou openai-compatible.
AI_PROVIDER=disabled
# AI_MODEL peut être choisi selon le fournisseur (voir les exemples du README.md).
AI_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Serveur compatible OpenAI (Ollama, vLLM, LM Studio, etc.); AI_API_KEY est facultative.
AI_BASE_URL=http://127.0.0.1:11434/v1
AI_API_KEY=
# Alias déclencheurs additionnels séparés par |. Le nom Discord du bot est reconnu automatiquement.
AI_TRIGGER_NAMES=
# Préférence de ton optionnelle; les règles de sécurité intégrées restent prioritaires.
AI_PERSONALITY=
AI_RATE_LIMIT_PER_MINUTE=4
AI_GLOBAL_RATE_LIMIT_PER_MINUTE=30
AI_MAX_INPUT_CHARS=1600
AI_MAX_OUTPUT_TOKENS=450
AI_CONTEXT_MESSAGES=8
AI_HTTP_TIMEOUT_MS=25000

# Outils manuels de Test/ — désactivés par défaut, même sur Kinetic.
# Pour un essai explicite : ENABLE_TEST_HOOKS=true + jeton aléatoire >= 32 octets.
# Le pont reste lié à 127.0.0.1 et n'est pas exposé sur Internet.
ENABLE_TEST_HOOKS=false
TEST_BRIDGE_TOKEN=

# Vérifie origin/<branche> périodiquement; les nouvelles du bot vont dans /updatelog,
# jamais dans MINECRAFT_CHANNEL_ID.
UPDATE_CHECK_ENABLED=true
UPDATE_CHECK_INTERVAL_MINUTES=5
# À activer sur le split Kinetic après vérification de git remote origin.
UPDATE_AUTO_INSTALL=false
UPDATE_RESTART_COUNTDOWN_SECONDS=60
# Facultatif : branche suivie (par défaut, branche active ou main si checkout détaché)
# UPDATE_BRANCH=main
# UPDATE_REMOTE=origin

# Discord ↔ Minecraft (héberger le bot sur Kinetic; ne jamais partager le jeton)
MINECRAFT_GUILD_ID=
MINECRAFT_BRIDGE_TOKEN=
MINECRAFT_NEWS_WEBHOOK_URL=

# Panneau web sécurisé (/controller); le secret n'est jamais publié dans Git.
# Génère un jeton avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEB_ADMIN_TOKEN=
WEB_PUBLIC_URL=
# Facultatif : préfixe si le proxy publie le panneau sous /musique, par exemple /musique
WEB_BASE_PATH=
# Active seulement si le reverse proxy remplace proprement X-Forwarded-For/Host/Proto.
WEB_TRUST_PROXY=false
# Le SSL s'arrête sur Kinetic; force néanmoins le cookie de session en Secure.
WEB_COOKIE_SECURE=true

# Présence globale du bot (modifiable aussi avec /presence par le propriétaire)
BOT_PRESENCE_STATUS=online
BOT_PRESENCE_TYPE=watching
BOT_PRESENCE_INTERVAL_SECONDS=60
# Sépare les activités par |. Le jeton {prefix} reprend COMMAND_PREFIX.
BOT_PRESENCE_TEXTS="la musique avec {prefix}play|{prefix}help pour les commandes"
MINECRAFT_CHANNEL_ID=
# Port attribué au split Bot Kinetic pour le pont WSS (SERVER_PORT est aussi lu)
PORT=
