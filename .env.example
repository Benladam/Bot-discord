# Requis pour connecter le bot Discord
DISCORD_TOKEN=

# Recherche du catalogue Spotify (morceaux, artistes, albums, playlists publiques)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Facultatif : marché utilisé pour la recherche Spotify (ISO pays)
MUSIC_MARKET=FR

# Facultatif : dossier persistant SQLite (monter un volume serveur ici en Docker)
BOT_DATA_DIR=

# Facultatif si ces programmes sont dans le PATH
YTDLP_PATH=
FFMPEG_PATH=

# Facultatif
COMMAND_PREFIX=!
