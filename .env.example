# Requis pour connecter le bot Discord
DISCORD_TOKEN=

# Recherche du catalogue Spotify (morceaux, artistes, albums, playlists publiques)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Facultatif : active le catalogue SoundCloud et le repli audio depuis/vers YouTube
SOUNDCLOUD_CLIENT_ID=

# Facultatif : marché utilisé pour la recherche Spotify (ISO pays)
MUSIC_MARKET=FR

# Facultatif : dossier SQLite; sur Kinetic, le dossier du serveur persiste entre redémarrages
BOT_DATA_DIR=

# Facultatif : chemins personnalisés; yt-dlp est téléchargé automatiquement s'il manque
YTDLP_PATH=
# Chemin relatif ou absolu. Plusieurs fichiers séparés par ; : premier prioritaire, suivants en secours.
# Vide : détecte data/youtube-cookies.txt s'il existe.
YOUTUBE_COOKIES_PATH=
FFMPEG_PATH=

# Quitte le vocal après 1 ou 2 minutes sans musique (défaut : 2)
VOICE_IDLE_TIMEOUT_MINUTES=2

# Facultatif
COMMAND_PREFIX=!

# Modules de pilotage locaux dans Test/ (ne jamais activer sur l'hébergement public)
ENABLE_TEST_MODULES=false

# Vérifie origin/<branche> périodiquement; les nouvelles du bot vont dans /updatelog,
# jamais dans MINECRAFT_CHANNEL_ID.
UPDATE_CHECK_ENABLED=true
UPDATE_CHECK_INTERVAL_MINUTES=5
# À activer sur le split Kinetic après vérification de git remote origin.
UPDATE_AUTO_INSTALL=false
UPDATE_RESTART_COUNTDOWN_SECONDS=60
# Facultatif : branche suivie (par défaut, branche active ou main si checkout détaché)
# UPDATE_BRANCH=main
# UPDATE_REMOTE=origin

# Discord ↔ Minecraft (héberger le bot sur Kinetic; ne jamais partager le jeton)
MINECRAFT_GUILD_ID=
MINECRAFT_BRIDGE_TOKEN=
MINECRAFT_NEWS_WEBHOOK_URL=

# Présence globale du bot (modifiable aussi avec /presence par le propriétaire)
BOT_PRESENCE_STATUS=online
BOT_PRESENCE_TYPE=watching
BOT_PRESENCE_INTERVAL_SECONDS=60
# Sépare les activités par |. Le jeton {prefix} reprend COMMAND_PREFIX.
BOT_PRESENCE_TEXTS="la musique avec {prefix}play|{prefix}help pour les commandes"
MINECRAFT_CHANNEL_ID=
# Port attribué au split Bot Kinetic pour le pont WSS (SERVER_PORT est aussi lu)
PORT=
