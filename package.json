{
  "name": "bot-discord-multifonction",
  "version": "2.0.0",
  "description": "Bot Discord multifonction : musique, modération et outils serveur",
  "author": "Bot Discord contributors",
  "license": "MIT",
  "main": "bot.js",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "music:pot:install": "node tools/setup/installPoToken.js",
    "start": "node supervisor.js",
    "dashboard": "node features/dashboard/localServer.js",
    "security:install": "node tools/security/installGitGuard.js",
    "security:check": "node tools/security/gitGuard.js --staged",
    "security:audit": "node tools/security/gitGuard.js --tracked",
    "test": "node --test \"commands/**/*.test.js\" \"core/**/*.test.js\" \"features/**/*.test.js\" \"shared/**/*.test.js\" \"tools/**/*.test.js\""
  },
  "dependencies": {
    "@snazzah/davey": "^0.1.6",
    "bgutils-js": "4.0.3",
    "discord-player": "7.2.0",
    "discord-player-youtubei": "3.1.0",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "ffmpeg-static": "^5.3.0",
    "googlevideo": "4.1.1",
    "simple-ytdl-core": "1.1.1",
    "spotify-web-api-node": "^5.0.2",
    "tweetnacl": "^1.0.3",
    "ws": "^8.18.0"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  },
  "overrides": {
    "@discord-player/extractor": {
      "file-type": "21.3.4"
    },
    "esbuild": "0.28.1"
  }
}
